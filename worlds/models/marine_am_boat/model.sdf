    <joint name='joint2_to_joint1' type='revolute'>
      <pose relative_to='g_base'>0 0 0.13156000000000001 0 0 0</pose>
      <parent>g_base</parent>
      <child>joint2</child>

      <dynamics><damping>2.0</damping><friction>0.05</friction></dynamics>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-2.9321</lower>
          <upper>2.9321</upper>
          <effort>5.0</effort>
          <velocity>3.0</velocity>
        </limit>
      </axis>
    </joint>
    <joint name='joint3_to_joint2' type='revolute'>
      <pose relative_to='joint2'>0 0 0 -3.1415926535746808 1.5707926536662187 1.5707926536359933</pose>
      <parent>joint2</parent>
      <child>joint3</child>

      <dynamics><damping>2.0</damping><friction>0.05</friction></dynamics>
