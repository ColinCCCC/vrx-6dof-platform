<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="marine_am_boat">
    <static>false</static>
    <self_collide>false</self_collide>
    <pose>0 0 -0.031 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <pose>0 0 -0.05 0 0 0</pose>
        <mass>4.0</mass>
        <inertia>
          <ixx>0.05</ixx>
          <iyy>0.35</iyy>
          <izz>0.38</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <collision name="hull_collision">
        <pose>0 0 -0.02 0 0 0</pose>
        <geometry>
          <box><size>0.95 0.26 0.16</size></box>
        </geometry>
      </collision>
      <visual name="hull_visual">
        <pose>0 0.0075 0.08 0 0 0</pose>
        <geometry>
          <mesh><uri>model://marine_am_boat/meshes/hull_clean.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.85 0.85 0.85 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
        </material>
      </visual>
    </link>
    <!-- 压载：降低重心 -->
    <link name="ballast">
      <pose>0 0 -0.13 0 0 0</pose>
      <inertial>
        <mass>1.2</mass>
        <inertia><ixx>0.008</ixx><iyy>0.020</iyy><izz>0.022</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="ballast_collision">
        <geometry><box><size>0.40 0.15 0.06</size></box></geometry>
      </collision>
      <visual name="ballast_visual">
        <geometry><box><size>0.40 0.15 0.06</size></box></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
    </link>

    <!-- 舷外浮筒：提高横稳性 -->
    <link name="outrigger_port">
      <pose>0 0.40 0.02 0 0 0</pose>
      <inertial>
        <mass>0.25</mass>
        <inertia><ixx>0.004</ixx><iyy>0.006</iyy><izz>0.004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="outrigger_port_collision">
        <geometry><box><size>0.55 0.10 0.10</size></box></geometry>
      </collision>
      <visual name="outrigger_port_visual">
        <geometry><box><size>0.55 0.10 0.10</size></box></geometry>
        <material><ambient>0.9 0.45 0.1 1</ambient><diffuse>1.0 0.55 0.1 1</diffuse></material>
      </visual>
    </link>
    <link name="outrigger_starboard">
      <pose>0 -0.40 0.02 0 0 0</pose>
      <inertial>
        <mass>0.25</mass>
        <inertia><ixx>0.004</ixx><iyy>0.006</iyy><izz>0.004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="outrigger_starboard_collision">
        <geometry><box><size>0.55 0.10 0.10</size></box></geometry>
      </collision>
      <visual name="outrigger_starboard_visual">
        <geometry><box><size>0.55 0.10 0.10</size></box></geometry>
        <material><ambient>0.9 0.45 0.1 1</ambient><diffuse>1.0 0.55 0.1 1</diffuse></material>
      </visual>
    </link>


    <plugin filename="libSimpleHydrodynamics.so" name="vrx::SimpleHydrodynamics">
      <link_name>base_link</link_name>
      <xDotU>0.0</xDotU>
      <yDotV>0.0</yDotV>
      <zDotW>0.0</zDotW>
      <kDotP>0.0</kDotP>
      <mDotQ>0.0</mDotQ>
      <nDotR>0.0</nDotR>
      <xU>10.0</xU>
      <yV>10.0</yV>
      <zW>60.0</zW>
      <kP>8.0</kP>
      <mQ>8.0</mQ>
      <nR>10.0</nR>
    </plugin>



    <!-- VRX 浮力/波浪插件：六个浮力点提供升沉、纵摇、横摇恢复力 -->
    <plugin filename="libSurface.so" name="vrx::Surface">
      <link_name>base_link</link_name>
      <hull_length>1.0</hull_length>
      <hull_radius>0.28</hull_radius>
      <fluid_level>0</fluid_level>
      <points>
        <point>-0.35  0.14 0</point>
        <point>-0.35 -0.14 0</point>
        <point> 0.00  0.14 0</point>
        <point> 0.00 -0.14 0</point>
        <point> 0.35  0.14 0</point>
        <point> 0.35 -0.14 0</point>
      </points>
      <wavefield>
        <topic>/vrx/wavefield/parameters</topic>
      </wavefield>
    </plugin>
    <plugin filename="libSurface.so" name="vrx::Surface">
      <link_name>outrigger_port</link_name>
      <hull_length>0.55</hull_length>
      <hull_radius>0.07</hull_radius>
      <fluid_level>0</fluid_level>
      <points>
        <point>-0.20 0 0</point>
        <point> 0.00 0 0</point>
        <point> 0.20 0 0</point>
      </points>
      <wavefield><topic>/vrx/wavefield/parameters</topic></wavefield>
    </plugin>
    <plugin filename="libSurface.so" name="vrx::Surface">
      <link_name>outrigger_starboard</link_name>
      <hull_length>0.55</hull_length>
      <hull_radius>0.07</hull_radius>
      <fluid_level>0</fluid_level>
      <points>
        <point>-0.20 0 0</point>
        <point> 0.00 0 0</point>
        <point> 0.20 0 0</point>
      </points>
      <wavefield><topic>/vrx/wavefield/parameters</topic></wavefield>
    </plugin>


    <link name='g_base'>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.40000000000000002</mass>
        <inertia>
          <ixx>0.00024000000000000001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00024000000000000001</iyy>
          <iyz>0</iyz>
          <izz>0.00024000000000000001</izz>
        </inertia>
      </inertial>
      <visual name='g_base_visual'>
        <pose>0 0 -0.029999999999999999 0 0 1.5708</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://marine_am_boat/meshes/mycobot/G_base.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name='g_base_fixed_joint_lump__joint1_visual_1'>
        <pose>0 0 0 0 0 -1.5708</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://marine_am_boat/meshes/mycobot/joint1.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
