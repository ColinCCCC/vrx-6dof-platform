    <joint name="base_to_ballast" type="fixed">
      <parent>base_link</parent><child>ballast</child>
    </joint>
    <joint name="base_to_outrigger_port" type="fixed">
      <parent>base_link</parent><child>outrigger_port</child>
    </joint>
    <joint name="base_to_outrigger_starboard" type="fixed">
      <parent>base_link</parent><child>outrigger_starboard</child>
    </joint>
    <joint name="boat_to_arm" type="fixed">
      <parent>base_link</parent>
      <child>g_base</child>
      <pose>0.10 0 0.075 0 0 0</pose>
    </joint>

    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
