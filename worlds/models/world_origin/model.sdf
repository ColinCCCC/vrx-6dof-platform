<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="world_origin">
    <static>true</static>
    <link name="link">
      <!-- 原点立柱：从水面 z=0 到 z=0.4 -->
      <visual name="pole">
        <pose>0 0 0.2 0 0 0</pose>
        <geometry><cylinder><radius>0.004</radius><length>0.4</length></cylinder></geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>0.9 0.9 0.9 1</diffuse>
        </material>
      </visual>
      <!-- X 轴（红） -->
      <visual name="axis_x">
        <pose>0.15 0 0.4 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.006</radius><length>0.3</length></cylinder></geometry>
        <material>
          <ambient>1 0.1 0.1 1</ambient>
          <diffuse>1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <!-- Y 轴（绿） -->
      <visual name="axis_y">
        <pose>0 0.15 0.4 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.006</radius><length>0.3</length></cylinder></geometry>
        <material>
          <ambient>0.1 1 0.1 1</ambient>
          <diffuse>0.1 1 0.1 1</diffuse>
        </material>
      </visual>
      <!-- Z 轴（蓝） -->
      <visual name="axis_z">
        <pose>0 0 0.55 0 0 0</pose>
        <geometry><cylinder><radius>0.006</radius><length>0.3</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.3 1 1</ambient>
          <diffuse>0.1 0.3 1 1</diffuse>
        </material>
      </visual>
      <!-- 原点白色小球 -->
      <visual name="origin_ball">
        <pose>0 0 0.4 0 0 0</pose>
        <geometry><sphere><radius>0.02</radius></sphere></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
