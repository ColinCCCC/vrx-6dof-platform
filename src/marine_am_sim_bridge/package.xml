<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>marine_am_gz_bridge</name>
  <version>0.1.0</version>
  <description>Publish the WAM-V model pose from Gazebo transport as ROS TF (world -> wamv).</description>
  <maintainer email="ColinCCCC@users.noreply.github.com">Colin</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>tf2_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>gz-transport13</depend>
  <depend>gz-msgs10</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
